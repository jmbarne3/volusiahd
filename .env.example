# Copy to .env and fill in. Never commit .env.
# In production this file lives at /srv/hsd/.env, owned by deploy, mode 600.

DEBUG=true
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-50
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

SITE_NAME=Volusia County Homeschool Directory
SITE_BASE_URL=http://localhost:8000

# Absolute paths in production, e.g. /srv/hsd/data/db.sqlite3
# DATABASE_PATH=
# MEDIA_ROOT=

# Transactional email (Resend free tier). Unused while DEBUG=true.
# EMAIL_HOST=smtp.resend.com
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=directory@example.org
