# Copy to .env and fill in. Never commit .env.
# Development only: in production on Fly these values come from fly.toml [env]
# and `fly secrets`, and .dockerignore keeps this file out of the image.

DEBUG=true
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-50
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

SITE_NAME=Volusia County Homeschool Directory
SITE_BASE_URL=http://localhost:8000

# Absolute paths if set; on Fly, DATABASE_PATH=/data/db.sqlite3
# DATABASE_PATH=
# MEDIA_ROOT=

# Transactional email (Resend free tier). Unused while DEBUG=true.
# EMAIL_HOST=smtp.resend.com
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=directory@example.org
